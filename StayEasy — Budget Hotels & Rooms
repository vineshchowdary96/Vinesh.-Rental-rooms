* { margin: 0px; padding: 0px; box-sizing: border-box; }

:root { --primary: #ee2c5b; --primary-dark: #c81f47; --secondary: #1a1a2e; --bg: #f5f6fa; --card-bg: #ffffff; --text: #1a1a2e; --text-light: #6b7280; --border: #e5e7eb; --success: #17a558; }

html, body { font-family: Poppins, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); scroll-behavior: smooth; }

a { text-decoration: none; color: inherit; }

button { font-family: inherit; cursor: pointer; }

img { display: block; max-width: 100%; }

.container { max-width: 1180px; margin: 0px auto; padding: 0px 20px; }

input, select { font-family: inherit; }

::-webkit-scrollbar { width: 8px; height: 8px; }

::-webkit-scrollbar-thumb { background: rgb(204, 204, 204); border-radius: 4px; }

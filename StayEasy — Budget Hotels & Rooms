.auth-card > p { color: var(--text-light); margin-bottom: 20px; font-size: 14px; }

.auth-note { margin-top: 14px; font-size: 12px; color: var(--text-light); text-align: center; }

.empty-page { text-align: center; padding: 80px 20px; display: flex; flex-direction: column; align-items: center; gap: 12px; }

.footer { background: var(--secondary); color: rgb(209, 213, 219); margin-top: 40px; }

